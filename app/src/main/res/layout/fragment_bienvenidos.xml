<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2"
    tools:context=".Bienvenidos">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO CON FLECHA Y TÍTULO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Volver"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#8C1D40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/matcha"
                android:text="Modulo 1 - Leccion 1"
                android:textColor="#2D2D2D"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- BARRA DE PROGRESO SUPERIOR -->
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="10dp"
            android:layout_marginBottom="25dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#8C1D40" />

        <!-- INSTRUCCIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/matcha"
            android:text="Escucha y repite"
            android:textColor="#2D2D2D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- TARJETA DE REPRODUCCIÓN AUDIO (BIENVENIDOS) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#F8F0E5"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnEscucharAudio"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Escuchar palabra"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="#8C1D40" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/matcha"
                    android:text="Hogä ehe"
                    android:textColor="#8C1D40"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/matcha"
                    android:text="(Bienvenidos)"
                    android:textColor="#2D2D2D"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN DE GRABACIÓN DE MICRÓFONO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnGrabar"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#8C1D40"
                app:cardCornerRadius="37.5dp"
                app:cardElevation="2dp">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:contentDescription="Grabar voz"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/matcha"
                android:text="Toca para grabar"
                android:textColor="#2D2D2D"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÓN CONTINUAR -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#8C1D40"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/matcha"
                android:text="Continuar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- INDICADOR DE PASOS (PASO 2 ACTIVO) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="4dp"
                android:background="@drawable/ic_login_background"
                android:backgroundTint="#E0DCD3" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="4dp"
                android:background="@drawable/ic_login_background"
                android:backgroundTint="#8C1D40" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="4dp"
                android:background="@drawable/ic_login_background"
                android:backgroundTint="#E0DCD3" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="4dp"
                android:background="@drawable/ic_login_background"
                android:backgroundTint="#E0DCD3" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="4dp"
                android:background="@drawable/ic_login_background"
                android:backgroundTint="#E0DCD3" />

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="4dp"
                android:background="@drawable/ic_login_background"
                android:backgroundTint="#E0DCD3" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>