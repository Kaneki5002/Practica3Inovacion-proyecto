<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".Ingresar">

    <!-- DECORACIÓN SUPERIOR IZQUIERDA -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="135dp"
        android:layout_gravity="top|start"
        android:scaleType="fitStart"
        android:src="@drawable/captura_de_pantalla_2026_11_05_083033" />

    <!-- DECORACIÓN SUPERIOR DERECHA -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="138dp"
        android:layout_gravity="top|end"
        android:scaleType="fitEnd"
        android:src="@drawable/captura_de_pantalla_2026_11_05_083054" />

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="50dp"
        android:paddingEnd="30dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/matcha"
            android:text="OtomíApp"
            android:textColor="@color/vino"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/matcha"
            android:text="Aprende ➔ Practica ➔ Avanza"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- LOGO ZORRO OTOMÍ -->
        <ImageView
            android:id="@+id/ingresar_imvlogo"
            android:layout_width="226dp"
            android:layout_height="306dp"
            android:layout_marginTop="20dp"
            android:contentDescription="Ilustración Otomí"
            android:scaleType="fitCenter"
            android:src="@drawable/captura_de_pantalla_2026_10_26_105038" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/matcha"
            android:gravity="center"
            android:text="Conecta con tu cultura a\ntravés del idioma Otomí"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BOTÓN 1: INICIAR -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ingresar_crdiniciar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/vino"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/matcha"
                android:text="Iniciar"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN 2: CREAR CUENTA (CON BORDE VINO) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ingresar_crdcrearcuenta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/vino"
            app:strokeWidth="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/matcha"
                android:text="Crear Cuenta"
                android:textColor="@color/vino"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TEXTO INFERIOR: REGÍSTRATE -->
        <LinearLayout
            android:id="@+id/ingresar_btnregistrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/matcha"
                android:text="¿No tienes cuenta? "
                android:textColor="#777777"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/matcha"
                android:text="Regístrate"
                android:textColor="@color/vino"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- DECORACIÓN INFERIOR -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/captura_de_pantalla_2026_11_05_083124" />

</FrameLayout>