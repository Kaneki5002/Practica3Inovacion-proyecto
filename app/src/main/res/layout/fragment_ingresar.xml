<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    tools:context=".Ingresar">

    <!-- DECORACIÓN SUPERIOR IZQUIERDA -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|start"
        android:scaleType="fitStart"
        android:src="@drawable/apoyo"
        app:tint="@color/vino" />

    <!-- DECORACIÓN SUPERIOR DERECHA -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|end"
        android:scaleType="fitEnd"
        android:src="@drawable/apoyo"
        app:tint="@color/vino" />

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="50dp"
        android:paddingEnd="30dp"
        android:paddingBottom="20dp">

        <!-- TÍTULO PRINCIPAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/matcha"
            android:text="OtomíApp"
            android:textColor="@color/vino"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- SUBTÍTULO CON FLECHAS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/matcha"
            android:text="Aprende ➔ Practica ➔ Avanza"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ILUSTRACIÓN DEL LOBO / ZORRO TENANGO -->
        <ImageView
            android:id="@+id/ingresar_imvlogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            android:contentDescription="Ilustración Otomí"
            android:scaleType="fitCenter"
            android:src="@drawable/logotipo_de_android"
            app:tint="@color/vino" />

        <!-- LEYENDA CENTRAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/matcha"
            android:gravity="center"
            android:text="Conecta con tu cultura a\ntravés del idioma Otomí"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ESPACIADOR FLEXIBLE PARA EMPUJAR LOS BOTONES ABAJO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BOTÓN 1: INICIAR (RELLENO COLOR VINO) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ingresar_crdiniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/vino"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/matcha"
                    android:text="Iniciar"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN 2: CREAR CUENTA (CON BORDE COLOR VINO) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ingresar_crdcrearcuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_launcher_background"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/matcha"
                    android:text="Crear Cuenta"
                    android:textColor="@color/vino"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TEXTO INFERIOR: REGÍSTRATE -->
        <LinearLayout
            android:id="@+id/ingresar_btnregistrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/matcha"
                android:text="¿No tienes cuenta? "
                android:textColor="#777777"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/matcha"
                android:text="Regístrate"
                android:textColor="@color/vino"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- BANNER DECORATIVO INFERIOR (CENEFA TENANGO) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/apoyo"
        app:tint="@color/vino" />

</FrameLayout>