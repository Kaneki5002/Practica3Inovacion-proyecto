<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2"
    tools:context=".Producto1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ENCABEZADO CON BOTÓN DE REGRESO Y TÍTULO -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Volver"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#8C1D40" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/matcha"
                        android:text="Modulo 1"
                        android:textColor="#8C1D40"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/matcha"
                        android:text="Saludos y Cortesia"
                        android:textColor="#2D2D2D"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- BARRA DE PROGRESO -->
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_marginBottom="25dp"
                android:max="100"
                android:progress="25"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:progressTint="#8C1D40" />

            <!-- ILUSTRACIÓN DE LA LECCIÓN -->
            <ImageView
                android:id="@+id/imgProducto"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="25dp"
                android:contentDescription="Ilustración lección"
                android:scaleType="fitCenter"
                android:src="@drawable/captura_de_pantalla_2026_11_05_084256" />

            <!-- CONTENIDO DE LA LECCIÓN -->
            <TextView
                android:id="@+id/txtNombreProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/matcha"
                android:text="Leccion 1"
                android:textColor="#8C1D40"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/matcha"
                android:text="Saludar"
                android:textColor="#2D2D2D"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                android:fontFamily="@font/matcha"
                android:gravity="center"
                android:text="Aprende a decir hola y otras frases basicas de cortesia en otomi"
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <!-- BOTÓN CONTINUAR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnComprar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#8C1D40"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/matcha"
                    android:text="Continuar"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>