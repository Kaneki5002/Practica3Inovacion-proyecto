<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="#4A0E17"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Foto de perfil registrada -->
    <androidx.cardview.widget.CardView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="35dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/nav_header_imvfoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/apoyo" />
    </androidx.cardview.widget.CardView>

    <!-- Nombre completo del usuario -->
    <TextView
        android:id="@+id/nav_header_txtnombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/matcha"
        android:text="Usuario Registrado"
        android:textColor="#EFEBE6"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Nombre de usuario (@usuario) -->
    <TextView
        android:id="@+id/nav_header_txtusuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/matcha"
        android:text="@usuario"
        android:textColor="#E89A3C"
        android:textSize="13sp" />

</LinearLayout>