<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F2"
    tools:context=".EditarPerfil">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ENCABEZADO -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#8C1D40" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/matcha"
                    android:text="Perfil"
                    android:textColor="#8C1D40"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- FOTO DE PERFIL CON BOTÓN DE CÁMARA -->
            <RelativeLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginBottom="12dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_centerInParent="true"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/imvFotoEditar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/apoyo" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    app:cardBackgroundColor="#8C1D40"
                    app:cardCornerRadius="17dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <!-- BOTÓN CAMBIAR FOTO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnCambiarFoto"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#8C1D40"
                app:cardCornerRadius="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/matcha"
                    android:text="Cambiar foto"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- CAMPOS EDICIÓN DE TEXTO -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" android:textColor="#2D2D2D" android:textSize="12sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtNombre" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="12dp" android:background="@drawable/ic_login_background" android:hint="Usuario" android:paddingHorizontal="12dp" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contraseña" android:textColor="#2D2D2D" android:textSize="12sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtPass" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="12dp" android:background="@drawable/ic_login_background" android:hint="••••••••••••" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nueva contraseña" android:textColor="#2D2D2D" android:textSize="12sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtNuevaPass" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="12dp" android:background="@drawable/ic_login_background" android:hint="••••••••" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirmar contraseña" android:textColor="#2D2D2D" android:textSize="12sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtConfirmPass" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="12dp" android:background="@drawable/ic_login_background" android:hint="••••••••" android:inputType="textPassword" android:paddingHorizontal="12dp" android:textSize="13sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correo" android:textColor="#2D2D2D" android:textSize="12sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtCorreo" android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="25dp" android:background="@drawable/ic_login_background" android:hint="user72@email.com" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:textSize="13sp"/>

            <!-- BOTÓN GUARDAR CAMBIOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnGuardarCambios"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#8C1D40"
                app:cardCornerRadius="25dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/matcha"
                    android:text="Guardar cambios"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BARRA INFERIOR FIJA -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FAF8F2"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/apoyo" app:tint="#666666"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/matcha" android:text="Inicio" android:textColor="#666666" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/reparar" app:tint="#666666"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/matcha" android:text="Progreso" android:textColor="#666666" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_usuario" app:tint="#8C1D40"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/matcha" android:text="Perfil" android:textColor="#8C1D40" android:textSize="10sp" android:textStyle="bold"/>
            <View android:layout_width="20dp" android:layout_height="3dp" android:layout_marginTop="2dp" android:background="#8C1D40"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/iphone_x" app:tint="#666666"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/matcha" android:text="Logros" android:textColor="#666666" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>